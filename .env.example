# --- DeepSeek Harness (dsh) web server port (host:container) ---
PORT=3080

# --- dsh version to build (latest, or pin like 0.1.1-rc.2) ---
DSH_VERSION=latest

# --- Bind address for the host port publish ---
# 127.0.0.1 (default) keeps the harness on the host loopback; 0.0.0.0 exposes
# it to the network. The web UI has no TLS/auth and agents execute arbitrary
# code, so only expose it to a trusted network (or front it with a reverse
# proxy) — see README "Security".
BIND_ADDRESS=127.0.0.1

# --- Extra /api browser-trust authorities, comma-separated (host or host:port) ---
# E.g. my-workstation.example.local,10.0.0.5:3080
DSH_TRUSTED_HOSTS=

# --- User/Group id mapping (match your host user with `id -u` / `id -g`) ---
PUID=1000
PGID=1000

# --- Host-side data directories (relative to the compose file) ---
# DATA_DIR holds the whole Harness home (profiles, settings, credentials,
# storages), mounted to the container's /data/.dsh
DATA_DIR=./dsh
WORKSPACE=./workspace

# --- Optional DeepSeek provider API key ---
# Also configurable in the web UI (Settings -> Models).
# DEEPSEEK_API_KEY=
